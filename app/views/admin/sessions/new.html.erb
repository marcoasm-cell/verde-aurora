<div class="w-full h-screen flex items-center justify-center">
  <div class="bg-white shadow-lg rounded-lg w-full max-w-md p-8">
    <!-- Logo -->
    <div class="flex justify-center mb-6">
      <img class="h-30 w-30 rounded-full" src="<%= image_path('logo.jpg') %>" alt="logo">
    </div>

    <!-- Formulário -->
    <form action="<%= admin_sessions_path %>" method="POST" class="space-y-6">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <!-- Email -->
      <div>
        <label for="email" class="block text-gray-700 font-medium mb-1">Email</label>
        <input type="email" id="email" name="email" placeholder="email@email.com"
                class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <!-- Senha -->
      <div>
        <label for="password" class="block text-gray-700 font-medium mb-1">Palavra-Passe</label>
        <input type="password" id="password" name="password" placeholder="********"
                class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>

      <!-- Botão de login -->
      <button type="submit"
        class="w-full bg-green-800 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md transition-colors">
        Entrar
      </button>
    </form>

    <!-- Links -->
    <%
=begin%>
 <div class="mt-6 text-center">
      <a href="/signup" class="text-blue-600 hover:underline">Criar conta</a> | 
      <a href="/forgot-password" class="text-blue-600 hover:underline">Esqueceu a senha?</a>
    </div> 
<%
=end%>
  </div>
</div>