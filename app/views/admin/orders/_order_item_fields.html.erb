<div class="border p-4 rounded-lg bg-gray-50 border-gray-300">
  <label class="block font-medium mb-1">Produto</label>
  <input type="hidden" name="order[order_items_attributes][][id]" value="<%= item.id %>">
  <input type="hidden" name="order[order_items_attributes][][_destroy]" value="" class="remove_item_hidden">
  <select name="order[order_items_attributes][][product_id]"
    class="w-full border rounded p-2 border-gray-300">
    <option value="">Selecione um produto</option>
    <% products.each do |p| %>
      <option value="<%= p.id %>" <%= 'selected' if item.product_id == p.id %>><%= p.name %></option>
    <% end %>
  </select>

  <label class="block font-medium mt-2 mb-1">Cor</label>
  <select name="order[order_items_attributes][][color_id]"
    class="w-full border rounded p-2 border-gray-300">
    <option value="">Selecione uma cor</option>
    <% colors.each do |p| %>
      <option value="<%= p.id %>" <%= 'selected' if item.color_id == p.id %>><%= p.name %></option>
    <% end %>
  </select>

  <label class="block font-medium mt-2 mb-1">Fragrância</label>
  <select name="order[order_items_attributes][][fragance_id]"
    class="w-full border rounded p-2 border-gray-300">
    <option value="">Selecione uma fragrância</option>
    <% fragances.each do |p| %>
      <option value="<%= p.id %>" <%= 'selected' if item.fragance_id == p.id %>><%= p.name %></option>
    <% end %>
  </select>

  <label class="block font-medium mt-2 mb-1">Quantidade</label>
  <input type="number" name="order[order_items_attributes][][quantity]"
    value="<%= item.quantity || 1 %>" class="w-full border rounded p-2 border-gray-300">

  <button type="button"
        class="remove_item mt-3 bg-red-500 text-white px-3 py-1 rounded">
    Remover
  </button>
</div>