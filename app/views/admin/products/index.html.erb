<a href="<%= new_admin_product_path %>" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 mt-28 rounded float-right mr-5">Novo Produto</a>
<h1 class="mt-28 text-2xl font-bold text-gray-800 p-6 py-2 ">Produtos</h1>

<div class="p-5">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nome</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Categoria</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Preço</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Visualizações</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Imagem</th>
          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @products.each do |product| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap"><%= product.name %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= product.category.name %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= product.price %></td>
          <td class="px-6 py-4 whitespace-nowrap"><%= product.views_count %></td>
          <td class="px-6 py-4 whitespace-nowrap">
            <a href="<%= product.image_url%>" target="_blank">
              <img src="<%= product.image_url%>" class="h-12 w-12 rounded-md">
            </a>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
            <a href="<%= edit_admin_product_path(product) %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded">Editar</a>
          </td>
        </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>