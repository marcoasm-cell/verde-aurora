<div class="mt-28 max-w-xl mx-auto bg-white shadow-lg rounded-lg p-8">
  <a href="<%= admin_products_path %>" class="text-blue-500 hover:underline">Voltar</a>
  <h1 class="mt-5 text-2xl font-bold mb-6 text-gray-800">Produto</h1>



  <%= form_for [:admin, @product], html: { multipart: true, class: "space-y-6"} do |f| %>
    
    <div class="space-y-2">
      <span>Visivel</span>
      <label class="flex items-center gap-2">
        <input type="checkbox" <%= 'checked' if @product.status %> value="1" class="checkbox" name="product[status]"  />
      </label>
    </div>
    <div class="space-y-2">
      <span>Destaque</span>
      <label class="flex items-center gap-2">
        <input type="checkbox" <%= 'checked' if @product.highlight %> value="1" class="checkbox" name="product[highlight]"  />
      </label>
    </div>
    <!-- Nome -->
    <div>
      <label class="block text-gray-700 font-medium mb-1">Nome do Produto</label>
      <input type="text" name="product[name]" value="<%= @product.name %>"
        class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 border-gray-300" 
        placeholder="Ex: Vela perfumada">
    </div>

    <!-- VÁRIAS IMAGENS -->
    <div>
      <%= f.label :images, "Imagens do Produto", class: "block text-gray-700 font-medium mb-1" %>

      <%= f.file_field :images, multiple: true, accept: "image/*",
          class: "w-full border rounded-md px-4 py-2 bg-white cursor-pointer focus:ring-2 focus:ring-blue-500 border-gray-300",
          id: "images_input" %>

      <!-- Preview antes do upload -->
      <div id="preview_container" class="flex flex-wrap gap-4 mt-4"></div>

      <!-- Imagens já anexadas -->
      <% if @product.images.attached? %>
        <h3 class="text-gray-700 mt-4 font-medium">Imagens existentes:</h3>
        <div class="flex flex-wrap gap-4 mt-2">
          <% @product.images.each do |img| %>
            <%= image_tag img, class: "w-32 h-32 object-cover rounded shadow-md" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <!-- Categoria -->
    <div>
      <label class="block text-gray-700 font-medium mb-1">Categoria</label>
      <select name="product[product_categories_attributes][][category_id]" multiple class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 border-gray-300"
        placeholder="Ex: Roupas">
          <option value=""></option>
        <% @categories.each do |category| %>
          <option value="<%= category.id %>" <%= 'selected' if @product.categories.include?(category) %>
            ><%= category.name %></option>
        <% end %>
      </select>
    </div>

    <!-- Preço -->
    <div>
      <label class="block text-gray-700 font-medium mb-1">Preço</label>
      <input type="number" name="product[price]" step="0.01" value="<%= @product.price %>"
        class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 border-gray-300"
        placeholder="Ex: 49.90">
    </div>


    <!-- Visualizações -->
    <div>
      <label class="block text-gray-700 font-medium mb-1">Visualizações</label>
      <input type="number" value="<%= @product.views_count %>" class="w-full border rounded-md px-4 py-2 bg-gray-100 border-gray-300" readonly>
    </div>
    <!-- Descrição -->
    <div>
      <label class="block text-gray-700 font-medium mb-1">Descrição</label>
      <textarea name="product[description]" rows="4"
        class="w-full border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 border-gray-300"
        placeholder="Detalhes sobre o produto..."><%= @product.description %></textarea>
    </div>

    <!-- Botão -->
    <button type="submit"
      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md transition">
      Guardar
    </button>

  <% end %>
  
</div>