<div class="col-12 col-lg-6 d-flex h-100 align-items-center position-relative bg-white rounded-4 px-5">
  <div class="new-session-form w-100 px-5">

    <h1 class="text-center">Todas as conversas</h1>
    <h1 class="text-center">Um só lugar</h1>

    <p class="mt-4 mb-5 text-center">Insira o seu e-mail para Recuperar a sua palavra-passe</p>

    <form action="<%= password_resets_path %>" class=" px-5" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <div class="form-group mt-4 mb-4">
        <label for="exampleInputEmail1" class="mb-2">E-mail*</label>
        <input type="email" name="email" class="form-control rounded-3 py-3" required id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email">
      </div>
      <p>Quer fazer login? Clique <a class="text-blue" href="<%= new_session_path %>">aqui</a></p>
      <button type="submit" class="btn btn-block btn-login rounded-3 w-100 mt-4 py-3 fw-bold">Recuperar palavra-passe</button>
    </form>
  </div>
</div>