<div class="col-12 col-lg-6 d-flex h-100 align-items-center position-relative bg-white rounded-4 px-5">
  <div class="new-session-form w-100 px-5">

    <h1 class="text-center">Todas as conversas</h1>
    <h1 class="text-center">Um só lugar</h1>

    <p class="mt-4 mb-5 text-center"><%= params[:initial] != "false" ? "Defina" : "Redefina" %> a sua palavra-passe</p>

    <form action="<%= password_reset_path(params[:id]) %>" class=" px-5" method="post">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="_method" value="patch">
      <div class="form-group mt-4">
        <label for="exampleInputPassword1" class="mb-2">Nova palavra-passe*</label>
        <input type="password" name="password" class="form-control rounded-3 py-3" required id="exampleInputPassword1" placeholder="Password">
      </div>
      <div class="form-group mt-4 mb-4">
        <label for="exampleInputPassword1" class="mb-2">Confirmar palavra-passe*</label>
        <input type="password" name="password_confirmation" class="form-control rounded-3 py-3" required id="exampleInputPassword1" placeholder="Password">
      </div>
      <p>Quer fazer login? Clique <a class="text-blue" href="<%= new_session_path %>">aqui</a></p>
      <button type="submit" class="btn btn-block btn-login rounded-3 w-100 mt-4 py-3 fw-bold">Confirmar</button>
    </form>
  </div>
</div>