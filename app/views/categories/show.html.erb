<div class="h-26" style="background-color: #456454ff">
</div>
<div class="mt-2 max-w-7xl mx-auto p-6 space-y-6">
    <h2 class="text-2xl md:text-3xl font-serif text-gray-800 tracking-wide mb-2"><%= @category.name %></h2>
</div>

<div class="max-w-7xl p-4 mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mx-auto" id="products">
    <% @products.each_with_index do |product, idx| %>
        <%= render partial: "application/partials/card", locals: { product: product, idx: idx } %>
    <% end %>
</div>