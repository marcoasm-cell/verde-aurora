<div class="bg-white overflow-hidde hover:scale-105 transition">

    <!-- IMAGE CAROUSEL -->
    <a href="<%= product_path(product) %>">
    <div class="relative rounded-lg overflow-hidden">
        <div class="splide">
            <div class="splide__track">
                <ul class="splide__list">
                    <% product.images.each do |img| %>
                        <li class="splide__slide">
                            <img src="<%= url_for(img) %>"
                                class="w-full h-68 object-cover"
                                alt="<%= product.name %>">
                        </li>
                    <% end %>
                </ul>
            </div>
            <div class="splide__arrows">
                <button class="splide__arrow splide__arrow--prev bg-black/40 text-white px-3 py-1 rounded-full">
                    ‹
                </button>
                <button class="splide__arrow splide__arrow--next bg-black/40 text-white px-3 py-1 rounded-full">
                    ›
                </button>
            </div>
        </div>
    </div>

    <div class="p-4">
        <h2 class="text-xl font-bold text-gray-800"><%= product.name %></h2>
        <p class="text-gray-600 text-sm mt-1"><%= product.description.truncate_words(5) %></p>

    </div>

    </a>
</div>