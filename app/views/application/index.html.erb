<div class="hidden md:flex relative w-full max-h-screen mx-auto overflow-hidden">
  <!-- Slides -->
  <div id="carousel-001" class="carousel flex transition-transform duration-500">
    <img src="<%= image_path('hero1.png') %>" class="object-cover w-full flex-shrink-0" />
    <img src="<%= image_path('hero2.png') %>" class="object-cover w-full flex-shrink-0" />
  </div>

  <button id="carousel-001" 
          class="carousel-prev hidden absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 text-white px-3 py-1 rounded-full">
    ‹
  </button>

  <button id="carousel-001"
          class="carousel-next hidden absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 text-white px-3 py-1 rounded-full">
    ›
  </button>

</div>

<div class="md:hidden relative w-full max-h-screen mx-auto overflow-hidden rounded-b-3xl">
  <!-- Slides -->
  <div id="carousel-002" class="carousel flex transition-transform duration-500">
    <img src="<%= image_path('hero_mobile1.png') %>" class="w-full flex-shrink-0" />
    <img src="<%= image_path('hero_mobile2.png') %>" class="w-full flex-shrink-0" />
  </div>



  <button id="carousel-002" 
          class="carousel-prev hidden absolute left-2 top-1/2 -translate-y-1/2 bg-black/40 text-white px-3 py-1 rounded-full">
    ‹
  </button>

  <button id="carousel-002"
          class="carousel-next hidden absolute right-2 top-1/2 -translate-y-1/2 bg-black/40 text-white px-3 py-1 rounded-full">
    ›
  </button>
</div>


<section class="relative py-12 mt-6">
  <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url(<%= image_path('3.jpg') %>)"></div>

  <div class="relative max-w-4xl mx-auto text-center px-6">
    <div class="w-24 mx-auto mb-4 border-t-4 border-amber-600"></div>

    <h2 class="text-3xl md:text-4xl font-serif text-gray-800 tracking-wide">
      Feito à mão com alma e intenção.
    </h2>

    <p class="mt-3 text-lg text-gray-600 font-light">
      Criações únicas feitas com paixão, tradição e coração.
    </p>

    <div class="w-24 mx-auto mt-4 border-b-4 border-amber-600"></div>
  </div>
</section>


<div class="max-w-7xl p-4 mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mx-auto" id="products">

  <!-- Loop through products -->
  <% @products.where(highlight: true).each_with_index do |product, idx| %>
    <%= render partial: "application/partials/card", locals: { product: product, idx: idx } %>
  <% end %>

</div>


<!-- Categories Banner -->
<section class="py-8 mt-6">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-6">
      <h2 class="text-2xl md:text-3xl font-serif text-gray-800 tracking-wide mb-2">
        Descubra
      </h2>
      <div class="w-24 mx-auto border-t-2 border-amber-600"></div>
    </div>
    
    <div class="flex flex-wrap justify-center gap-4 md:gap-6">
      <% @categories.each do |category| %>
        <a href="<%= category_path(category) %>" 
           class="w-50 group relative overflow-hidden bg-white rounded-lg shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1 min-w-[140px] md:min-w-[180px]">
          <div class="p-6 md:p-8 text-center">
            <div class="mb-3">
                <img src="<%= url_for(category.products.first.images.first ) %>" class="w-16 h-16  mx-auto object-cover rounded-full">
            </div>
            <h3 class="text-base md:text-lg font-semibold text-gray-800 group-hover:text-amber-700 transition-colors duration-300">
              <%= category.name %>
            </h3>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>


<div class="max-w-7xl p-4 mt-2 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mx-auto" id="products">

  <!-- Loop through products -->
  <% @products.where(highlight: false).each_with_index do |product, idx| %>
    <%= render partial: "application/partials/card", locals: { product: product, idx: idx } %>
  <% end %>

</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {

    document.querySelectorAll(".carousel").forEach((carousel) => {
      let index = 0;
      const slides = carousel.children;
      const total = slides.length;

      const update = () =>
        carousel.style.transform = `translateX(-${index * 100}%)`;

      const prev = carousel.parentElement.querySelector(".carousel-prev");
      const next = carousel.parentElement.querySelector(".carousel-next");

      prev.addEventListener("click", () => {
        index = (index - 1 + total) % total;
        update();
      });

      next.addEventListener("click", () => {
        index = (index + 1) % total;
        update();
      });

      // --- SWIPE SUPPORT ---
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      const startDrag = (x) => {
        isDragging = true;
        startX = x;
        carousel.style.transition = "none";
      };

      const moveDrag = (x) => {
        if (!isDragging) return;
        currentX = x;
        const deltaX = currentX - startX;
        carousel.style.transform =
          `translateX(calc(${-index * 100}% + ${deltaX}px))`;
      };

      const endDrag = () => {
        if (!isDragging) return;
        isDragging = false;
        const deltaX = currentX - startX;

        // If swipe big enough → change slide
        if (Math.abs(deltaX) > 50) {
          if (deltaX < 0) index = (index + 1) % total; // swipe left → next
          else index = (index - 1 + total) % total;    // swipe right → prev
        }

        // snap back
        carousel.style.transition = "transform .4s ease";
        update();
      };

      // Touch events
      carousel.addEventListener("touchstart", (e) => startDrag(e.touches[0].clientX));
      carousel.addEventListener("touchmove", (e) => moveDrag(e.touches[0].clientX));
      carousel.addEventListener("touchend", endDrag);

      // Mouse events (optional — swipe with mouse on desktop)
      carousel.addEventListener("mousedown", (e) => startDrag(e.clientX));
      carousel.addEventListener("mousemove", (e) => moveDrag(e.clientX));
      carousel.addEventListener("mouseup", endDrag);
      carousel.addEventListener("mouseleave", endDrag);
    });

  });
</script>
